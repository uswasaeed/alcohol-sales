library(tidyverse)
library(janitor)
library(lubridate)
library(readr)
#| label: import
bev_clean <- read_rds("data-processed/bev_clean.rds")
bev_clean |> glimpse()
annual_sales <- bev_clean |>
group_by(year) |>
summarize(
total_sales = sum(total_receipts, na.rm = TRUE)
) |>
arrange(year)
annual_sales
annual_sales |>
filter(year %in% c(2019, 2020, 2021))

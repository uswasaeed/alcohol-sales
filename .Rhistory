zip_base <- bev_clean |>
filter(year == 2019) |>
group_by(location_zip) |>
summarize(base_2019 = sum(total_receipts, na.rm = TRUE))
zip_recovery <- bev_clean |>
filter(year != 2026) |>
group_by(location_zip, year) |>
summarize(total_sales = sum(total_receipts, na.rm = TRUE), .groups = "drop") |>
left_join(zip_base, by = "location_zip") |>
mutate(recovery_index = total_sales / base_2019)
zip_base <- bev_clean |>
filter(year == 2019) |>
group_by(location_zip) |>
summarize(base_2019 = sum(total_receipts, na.rm = TRUE))
zip_recovery <- bev_clean |>
filter(year != 2026) |>
group_by(location_zip, year) |>
summarize(total_sales = sum(total_receipts, na.rm = TRUE), .groups = "drop") |>
left_join(zip_base, by = "location_zip") |>
mutate(recovery_index = total_sales / base_2019)
zip_recovery
